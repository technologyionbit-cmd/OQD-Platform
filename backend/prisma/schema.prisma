// Aqd Backend — Prisma schema
//
// Phase 1A scope ONLY: infrastructure/identity/organization foundation
// (docs/backend/16-backend-roadmap.md, Phase 1 table list):
//   users, refresh_tokens, verification_codes, lawyer_registration_details,
//   organizations, organization_members, organization_invitations
//
// Full field/relationship rationale: docs/backend/01-domain-model.md §1-2
// Ownership/tenancy rationale: docs/backend/03-multi-tenancy.md
// Table/index/constraint notes: docs/backend/04-database-design.md
//
// No other domain tables (lawyer profiles, contracts, consultations, etc.)
// are created in this phase — those belong to Phase 2+.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext, btree_gist]
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

/// docs/backend/01-domain-model.md — "Drives UX only... must never be treated
/// as an authorization mechanism." Kept as account type, not a permission.
enum UserRole {
  client
  lawyer
  company
  /// Staff. Never self-registered: promote an existing account in the DB.
  /// Reviews lawyer verification through /v1/admin.
  admin
}

enum UserStatus {
  active
  suspended
  banned
  pendingDeletion
}

/// docs/backend/01-domain-model.md §Enum reference — 8 fixed values.
enum LawyerSpecialty {
  commercial
  personalStatus
  criminal
  labor
  realEstate
  corporate
  intellectualProperty
  general
}

enum VerificationChannel {
  email
  sms
}

enum VerificationPurpose {
  passwordReset
  phoneVerification
}

enum OrganizationVerificationStatus {
  unverified
  pending
  verified
  rejected
}

/// docs/backend/01-domain-model.md §2 — frontend has admin/manager/member;
/// backend adds `owner`, auto-assigned to Organization.ownerUserId and
/// never removable via the member-management endpoints built in a later phase.
enum OrgMemberRole {
  owner
  admin
  manager
  member
}

enum OrgMemberStatus {
  invited
  active
  removed
}

enum OrgInvitationStatus {
  pending
  accepted
  declined
  expired
  revoked
}

/// docs/backend/01-domain-model.md §10 — 4 fixed values, matches the
/// frontend's `GovProcedureType` enum exactly.
enum GovProcedureType {
  companyRegistration
  propertyRegistration
  contractNotarization
  lawsuitFiling
}

enum GovProcedureAccessType {
  directLink
  guide
}

/// docs/backend/01-domain-model.md §3 — replaces the frontend's two
/// independent booleans (isVerified/hasPendingVerification).
enum LawyerVerificationStatus {
  unverified
  pending
  verified
  rejected
}

/// docs/backend/01-domain-model.md §3 — mirrors the frontend's
/// `ConsultationType` enum exactly (video, voice, written).
enum ConsultationType {
  video
  voice
  written
}

/// Booking-stage + terminal-outcome states only — the frontend's
/// `ConsultationStatus` also has live-session states (waiting/ready/
/// connecting/active/ended) but those belong to Part 5 (Consultation
/// Room) and are never persisted here: they exist only in that feature's
/// own client-local session state until Part 5 builds a real backing
/// store for them. `confirmed` transitions straight to `completed`/
/// `missed`/`failed` from this table's point of view.
enum ConsultationStatus {
  pendingApproval
  confirmed
  completed
  cancelled
  declined
  missed
  failed
}

/// Part 5's own state machine — mirrors the frontend's `SessionState`
/// exactly (`waiting -> ready -> connecting -> active -> ended`, with
/// `failed` reachable from `connecting` or `active`). Deliberately
/// separate from `ConsultationStatus`, which stays booking/outcome-only.
enum ConsultationRoomState {
  waiting
  ready
  connecting
  active
  ended
  failed
}

/// Append-only log of a participant joining, leaving, or reconnecting to
/// a room session — never updated or deleted, only inserted.
enum ConsultationParticipantEventType {
  join
  leave
  reconnect
}

/// Contract lifecycle (docs/backend/08-contracts-documents-signatures.md).
/// `signed` is the final successful state in v1; `completed` exists for
/// the app's enum but nothing moves a contract there yet.
enum ContractStatus {
  draft
  pendingSignature
  signed
  completed
  cancelled
}

enum ContractCategory {
  employment
  sale
  rental
  partnership
  nda
  serviceAgreement
  other
}

// -----------------------------------------------------------------------------
// 1. Identity & Access — docs/backend/01-domain-model.md §1
// -----------------------------------------------------------------------------

model User {
  id               String     @id @default(uuid()) @db.Uuid
  fullName         String     @map("full_name")
  email            String     @unique @db.Citext
  /// Sign-in identifier and where every code is texted: E.164 Jordanian
  /// mobile (+9627XXXXXXXX). Null only for accounts whose stored number
  /// could not be normalized when phone sign-in was introduced.
  phone            String?    @unique
  phoneVerifiedAt  DateTime?  @map("phone_verified_at") @db.Timestamptz
  passwordHash     String     @map("password_hash")
  role             UserRole
  status           UserStatus @default(active)
  twoFactorEnabled Boolean    @default(false) @map("two_factor_enabled")
  lastLoginAt      DateTime?  @map("last_login_at") @db.Timestamptz
  /// When the user accepted the terms/privacy policy, and which version.
  /// Null only for accounts created before acceptance was recorded.
  termsAcceptedAt  DateTime?  @map("terms_accepted_at") @db.Timestamptz
  termsVersion     String?    @map("terms_version")
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime?  @map("deleted_at") @db.Timestamptz

  lawyerRegistrationDetail LawyerRegistrationDetail?
  refreshTokens            RefreshToken[]
  verificationCodes        VerificationCode[]
  ownedOrganizations       Organization[]             @relation("OrganizationOwner")
  organizationMemberships  OrganizationMember[]
  sentInvitations          OrganizationInvitation[]   @relation("InvitationSender")
  govProcedureProgress     UserGovProcedureProgress[]
  lawyerProfile            LawyerProfile?
  writtenReviews           Review[]
  bookedConsultations      Consultation[]
  contracts                Contract[]
  contractSignatures       ContractSignature[]
  notifications            Notification[]

  @@index([role])
  @@map("users")
}

/// One-to-one with User where role = lawyer. Captures registration-time
/// fields (barLicenseNumber, mainSpecialty) that the frontend collects but
/// discards. Feeds initial LawyerProfile creation in Phase 2 — not created here.
model LawyerRegistrationDetail {
  userId           String          @id @map("user_id") @db.Uuid
  barLicenseNumber String          @unique @map("bar_license_number")
  mainSpecialty    LawyerSpecialty @map("main_specialty")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("lawyer_registration_details")
}

/// Backs refresh-token rotation and the "Active Sessions" UI
/// (SecurityPrivacyScreen). Never stores the raw token, only its hash.
model RefreshToken {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash")
  deviceLabel      String?   @map("device_label")
  ipAddress        String?   @map("ip_address") @db.Inet
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// Backs requestOtp/verifyOtp/resetPassword. userId is nullable because
/// email-verification codes may be issued before the User row exists in
/// some registration flows.
model VerificationCode {
  id           String              @id @default(uuid()) @db.Uuid
  userId       String?             @map("user_id") @db.Uuid
  destination  String
  channel      VerificationChannel
  codeHash     String              @map("code_hash")
  purpose      VerificationPurpose
  expiresAt    DateTime            @map("expires_at") @db.Timestamptz
  consumedAt   DateTime?           @map("consumed_at") @db.Timestamptz
  attemptCount Int                 @default(0) @map("attempt_count")
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([destination, purpose])
  @@map("verification_codes")
}

// -----------------------------------------------------------------------------
// 2. Organization / Company — docs/backend/01-domain-model.md §2
// -----------------------------------------------------------------------------

/// NEW entity entirely relative to the frontend (docs/backend/03-multi-tenancy.md
/// §5). Owned by the `company`-role user that created it.
model Organization {
  id                           String                         @id @default(uuid()) @db.Uuid
  name                         String
  commercialRegistrationNumber String                         @unique @map("commercial_registration_number")
  ownerUserId                  String                         @map("owner_user_id") @db.Uuid
  verificationStatus           OrganizationVerificationStatus @default(unverified) @map("verification_status")
  createdAt                    DateTime                       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                    DateTime                       @updatedAt @map("updated_at") @db.Timestamptz

  // ON DELETE RESTRICT: an org must never be left ownerless silently —
  // ownership transfer must be an explicit action (docs/backend/04-database-design.md §4).
  owner       User                     @relation("OrganizationOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  members     OrganizationMember[]
  invitations OrganizationInvitation[]

  @@index([ownerUserId])
  @@map("organizations")
}

/// docs/backend/01-domain-model.md §2 — frontend's TeamMember has no
/// organizationId at all (single implicit company). userId is nullable
/// until an invited email registers/links to an account.
model OrganizationMember {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  userId         String?         @map("user_id") @db.Uuid
  email          String          @db.Citext
  fullName       String          @map("full_name")
  role           OrgMemberRole
  status         OrgMemberStatus @default(invited)
  joinedAt       DateTime?       @map("joined_at") @db.Timestamptz
  invitedAt      DateTime        @default(now()) @map("invited_at") @db.Timestamptz
  removedAt      DateTime?       @map("removed_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Postgres treats NULL as distinct in a UNIQUE constraint, so this
  // naturally behaves as "unique where user_id IS NOT NULL" per
  // docs/backend/04-database-design.md §4 without needing a partial index.
  @@unique([organizationId, userId])
  // docs/backend/04-database-design.md §4 also calls for
  // UNIQUE (organization_id, lower(email)) WHERE status = 'invited'.
  // That's a partial unique index, which Prisma's schema DSL cannot express
  // declaratively — add it by hand-editing the SQL of the first
  // `prisma migrate dev` migration before applying it. Indexed here for
  // query performance in the meantime.
  @@index([organizationId, email])
  @@index([userId])
  @@map("organization_members")
}

/// NEW entity — frontend's addMember is synchronous/immediate with no
/// token, no expiry, no accept/decline step.
model OrganizationInvitation {
  id              String              @id @default(uuid()) @db.Uuid
  organizationId  String              @map("organization_id") @db.Uuid
  email           String              @db.Citext
  role            OrgMemberRole
  token           String              @unique
  invitedByUserId String              @map("invited_by_user_id") @db.Uuid
  status          OrgInvitationStatus @default(pending)
  expiresAt       DateTime            @map("expires_at") @db.Timestamptz
  respondedAt     DateTime?           @map("responded_at") @db.Timestamptz
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitationSender", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([email])
  @@map("organization_invitations")
}

// -----------------------------------------------------------------------------
// 3. Government Procedures — docs/backend/01-domain-model.md §10
//
// A small, fixed reference catalog (4 procedures, seeded once from the
// content the frontend currently hardcodes in
// gov_procedures_provider.dart) plus real per-user progress persistence
// (the frontend's GovProceduresProgressController is in-memory only today).
// -----------------------------------------------------------------------------

model GovProcedure {
  id            String                 @id @default(uuid()) @db.Uuid
  type          GovProcedureType       @unique
  durationLabel Json                   @map("duration_label")
  accessType    GovProcedureAccessType @map("access_type")
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime               @updatedAt @map("updated_at") @db.Timestamptz

  requiredDocuments GovRequiredDocument[]
  steps             GovProcedureStep[]
  progress          UserGovProcedureProgress[]

  @@map("gov_procedures")
}

model GovRequiredDocument {
  id          String @id @default(uuid()) @db.Uuid
  procedureId String @map("procedure_id") @db.Uuid
  title       Json
  sortOrder   Int    @default(0) @map("sort_order")

  procedure GovProcedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  @@index([procedureId])
  @@map("gov_required_documents")
}

model GovProcedureStep {
  id          String @id @default(uuid()) @db.Uuid
  procedureId String @map("procedure_id") @db.Uuid
  sortOrder   Int    @map("sort_order")
  title       Json
  description Json

  procedure GovProcedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  @@index([procedureId])
  @@map("gov_procedure_steps")
}

/// NEW relative to the frontend — GovProceduresProgressController resets
/// on every app restart today; this table is the real backing store.
model UserGovProcedureProgress {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  procedureId        String    @map("procedure_id") @db.Uuid
  startedAt          DateTime? @map("started_at") @db.Timestamptz
  checkedDocumentIds String[]  @default([]) @map("checked_document_ids") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  procedure GovProcedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  @@unique([userId, procedureId])
  @@map("user_gov_procedure_progress")
}

// -----------------------------------------------------------------------------
// 4. Lawyer Marketplace — docs/backend/01-domain-model.md §3,
// docs/backend/09-lawyers-marketplace.md
//
// docs/plans/individual-user-rollout.md Part 3 scope: client-facing
// search/browse only (GET endpoints). Lawyer self-service (GET/PATCH
// /v1/lawyers/me, verification submission, admin verify/reject) is
// lawyer-side and out of scope here — LawyerProfile.userId is unified with
// User.id now (per 09-lawyers-marketplace.md §2) so that work is additive
// later, not a re-migration.
// -----------------------------------------------------------------------------

model LawyerProfile {
  id                          String                   @id @default(uuid()) @db.Uuid
  userId                      String                   @unique @map("user_id") @db.Uuid
  fullName                    String                   @map("full_name")
  bio                         String                   @default("")
  yearsOfExperience           Int                      @default(0) @map("years_of_experience")
  barLicenseNumber            String                   @map("bar_license_number")
  rating                      Decimal                  @default(0) @db.Decimal(3, 2)
  reviewsCount                Int                      @default(0) @map("reviews_count")
  verificationStatus          LawyerVerificationStatus @default(unverified) @map("verification_status")
  verificationRejectionReason String?                  @map("verification_rejection_reason")
  /// When the lawyer last sent documents for review.
  verificationSubmittedAt     DateTime?                @map("verification_submitted_at") @db.Timestamptz
  /// The admin who approved or rejected the latest submission, and when.
  verificationReviewedById    String?                  @map("verification_reviewed_by_id") @db.Uuid
  verificationReviewedAt      DateTime?                @map("verification_reviewed_at") @db.Timestamptz
  createdAt                   DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                   DateTime                 @updatedAt @map("updated_at") @db.Timestamptz

  user                  User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialties           LawyerProfileSpecialty[]
  offerings             LawyerConsultationOffering[]
  reviews               Review[]
  availabilitySlots     AvailabilitySlot[]
  consultations         Consultation[]
  verificationDocuments LawyerVerificationDocument[]

  @@index([verificationStatus])
  @@map("lawyer_profiles")
}

/// Join table — a lawyer has many specialties from the fixed 8-value
/// LawyerSpecialty enum (already defined above, shared with
/// LawyerRegistrationDetail.mainSpecialty).
model LawyerProfileSpecialty {
  id              String          @id @default(uuid()) @db.Uuid
  lawyerProfileId String          @map("lawyer_profile_id") @db.Uuid
  specialty       LawyerSpecialty

  lawyerProfile LawyerProfile @relation(fields: [lawyerProfileId], references: [id], onDelete: Cascade)

  @@unique([lawyerProfileId, specialty])
  @@map("lawyer_profile_specialties")
}

/// Normalizes the frontend's `Map<ConsultationType, double> pricing` +
/// `List<ConsultationType> consultationTypes` into rows, so a lawyer can
/// stop offering a type without losing price history tied to past
/// consultations (which snapshot price at booking time — Part 4).
model LawyerConsultationOffering {
  id               String           @id @default(uuid()) @db.Uuid
  lawyerProfileId  String           @map("lawyer_profile_id") @db.Uuid
  consultationType ConsultationType @map("consultation_type")
  price            Decimal          @db.Decimal(10, 2)
  currency         String           @default("SAR")
  isActive         Boolean          @default(true) @map("is_active")

  lawyerProfile LawyerProfile @relation(fields: [lawyerProfileId], references: [id], onDelete: Cascade)

  @@unique([lawyerProfileId, consultationType])
  @@map("lawyer_consultation_offerings")
}

/// A file a lawyer sent to prove their license (ID, bar card). Stored on
/// private disk under `storageKey` (see FileStorageService); only the
/// owner and admins can reach it through the API. Kept after review as
/// the audit trail of what was approved.
model LawyerVerificationDocument {
  id              String   @id @default(uuid()) @db.Uuid
  lawyerProfileId String   @map("lawyer_profile_id") @db.Uuid
  storageKey      String   @unique @map("storage_key")
  originalName    String   @map("original_name")
  mimeType        String   @map("mime_type")
  sizeBytes       Int      @map("size_bytes")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  lawyerProfile LawyerProfile @relation(fields: [lawyerProfileId], references: [id], onDelete: Cascade)

  @@index([lawyerProfileId, createdAt])
  @@map("lawyer_verification_documents")
}

/// The frontend's "Reviews" section was two hardcoded static entries in
/// Part 3 — now a real submission flow, gated on the reviewed
/// `Consultation` being `completed` (enforced in the service, not here).
model Review {
  id              String   @id @default(uuid()) @db.Uuid
  lawyerProfileId String   @map("lawyer_profile_id") @db.Uuid
  consultationId  String   @map("consultation_id") @db.Uuid
  reviewerUserId  String   @map("reviewer_user_id") @db.Uuid
  rating          Int
  comment         String?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  lawyerProfile LawyerProfile @relation(fields: [lawyerProfileId], references: [id], onDelete: Cascade)
  consultation  Consultation  @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  reviewer      User          @relation(fields: [reviewerUserId], references: [id], onDelete: Cascade)

  @@unique([consultationId, reviewerUserId])
  @@index([lawyerProfileId])
  @@map("reviews")
}

// -----------------------------------------------------------------------------
// 5. Consultations & Booking — docs/backend/01-domain-model.md §4,
// docs/backend/06-consultations.md
//
// docs/plans/individual-user-rollout.md Part 4 scope: booking-stage +
// terminal-outcome lifecycle (see ConsultationStatus doc comment above).
// Live-session runtime (waiting/ready/connecting/active/ended,
// ConsultationRoomSession) is Part 5, not built here.
// -----------------------------------------------------------------------------

/// A lawyer's bookable hour slot. `isBooked` + the unique 1:1 relation from
/// `Consultation` are the application-level guard against double-booking;
/// the `no_overlapping_booked_slots` exclusion constraint (hand-added to
/// this model's migration SQL — Prisma DSL can't express EXCLUDE) is the
/// DB-level guard against two *overlapping* slots both ending up booked
/// under a race, which a single row's boolean flag alone can't catch.
model AvailabilitySlot {
  id              String   @id @default(uuid()) @db.Uuid
  lawyerProfileId String   @map("lawyer_profile_id") @db.Uuid
  startAt         DateTime @map("start_at") @db.Timestamptz
  endAt           DateTime @map("end_at") @db.Timestamptz
  isBooked        Boolean  @default(false) @map("is_booked")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  lawyerProfile LawyerProfile @relation(fields: [lawyerProfileId], references: [id], onDelete: Cascade)
  consultation  Consultation?

  @@index([lawyerProfileId, startAt])
  @@map("availability_slots")
}

/// `lawyerName`/`clientName` are snapshotted at booking time (matches the
/// frontend's `Consultation` entity, which carries both names directly
/// rather than joining) — a display name changing later must never rewrite
/// history on a past booking. `price` is likewise snapshotted from the
/// matching `LawyerConsultationOffering` at booking time, computed
/// server-side (never trusted from the client) so a tampered request body
/// can't book below the lawyer's real price.
model Consultation {
  id                 String             @id @default(uuid()) @db.Uuid
  clientUserId       String             @map("client_user_id") @db.Uuid
  lawyerProfileId    String             @map("lawyer_profile_id") @db.Uuid
  availabilitySlotId String             @unique @map("availability_slot_id") @db.Uuid
  lawyerName         String             @map("lawyer_name")
  clientName         String             @map("client_name")
  type               ConsultationType
  status             ConsultationStatus @default(pendingApproval)
  scheduledAt        DateTime           @map("scheduled_at") @db.Timestamptz
  price              Decimal            @db.Decimal(10, 2)
  notes              String             @default("")
  cancellationReason String?            @map("cancellation_reason")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  client           User                     @relation(fields: [clientUserId], references: [id], onDelete: Cascade)
  lawyerProfile    LawyerProfile            @relation(fields: [lawyerProfileId], references: [id], onDelete: Cascade)
  availabilitySlot AvailabilitySlot         @relation(fields: [availabilitySlotId], references: [id], onDelete: Restrict)
  reviews          Review[]
  roomSession      ConsultationRoomSession?

  @@index([clientUserId])
  @@index([lawyerProfileId])
  @@map("consultations")
}

// -----------------------------------------------------------------------------
// 6. Consultation Room (live session) — docs/plans/individual-user-rollout.md Part 5
// -----------------------------------------------------------------------------

/// One row per consultation — created the first time either participant
/// calls `POST .../room/token`. `durationSeconds`/tick-by-tick call time is
/// deliberately NOT persisted here: the frontend's `SessionController`
/// ticks that forward client-side once a second purely in memory (see
/// `incrementDuration()`), never round-tripping to the server — persisting
/// it would mean one HTTP call per second per active call for no benefit
/// this phase (no cross-device duration sync requirement yet).
model ConsultationRoomSession {
  id                String                @id @default(uuid()) @db.Uuid
  consultationId    String                @unique @map("consultation_id") @db.Uuid
  state             ConsultationRoomState @default(waiting)
  isMuted           Boolean               @default(false) @map("is_muted")
  isCameraOn        Boolean               @default(true) @map("is_camera_on")
  isSpeakerOn       Boolean               @default(true) @map("is_speaker_on")
  reconnectAttempts Int                   @default(0) @map("reconnect_attempts")
  endedAt           DateTime?             @map("ended_at") @db.Timestamptz
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  consultation Consultation                   @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  tokens       ConsultationRoomToken[]
  events       ConsultationParticipantEvent[]

  @@map("consultation_room_sessions")
}

/// The mock join token's real-world backing — opaque random string, only
/// its SHA-256 hash stored (same pattern as `RefreshToken`). Single-use
/// (`consumedAt`), scoped to exactly one `(sessionId, userId)` pair, and
/// short-lived (`expiresAt`, TTL <= 5 minutes) per
/// docs/backend/14-security.md §Token security — the security shape is
/// real from day one even though there is no real media provider behind
/// it yet, so swapping in Agora/Twilio/LiveKit later needs no redesign
/// here.
model ConsultationRoomToken {
  id         String    @id @default(uuid()) @db.Uuid
  sessionId  String    @map("session_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  session ConsultationRoomSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, userId])
  @@map("consultation_room_tokens")
}

/// Append-only join/leave/reconnect log — never updated, only inserted.
/// Exists for observability/audit of the live-session runtime; nothing
/// reads it back into an API response yet.
model ConsultationParticipantEvent {
  id        String                           @id @default(uuid()) @db.Uuid
  sessionId String                           @map("session_id") @db.Uuid
  userId    String                           @map("user_id") @db.Uuid
  eventType ConsultationParticipantEventType @map("event_type")
  createdAt DateTime                         @default(now()) @map("created_at") @db.Timestamptz

  session ConsultationRoomSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("consultation_participant_events")
}

// -----------------------------------------------------------------------------
// 7. Contracts — docs/backend/08-contracts-documents-signatures.md
// -----------------------------------------------------------------------------

/// A contract built from a template in the code catalog
/// (src/contracts/contract-templates.ts). `templateKey` + `templateVersion`
/// record which template text it was made from, so later template edits
/// never change a generated or signed contract. `locale` is the language
/// of `title` and `generatedContent`.
model Contract {
  id               String           @id @default(uuid()) @db.Uuid
  ownerUserId      String           @map("owner_user_id") @db.Uuid
  templateKey      String           @map("template_key")
  templateVersion  Int              @map("template_version")
  category         ContractCategory
  locale           String
  title            String
  status           ContractStatus   @default(draft)
  /// Field id -> value as the user entered it (strings only).
  fieldValues      Json             @map("field_values")
  parties          String[]
  generatedContent String?          @map("generated_content")
  generatedAt      DateTime?        @map("generated_at") @db.Timestamptz
  signedAt         DateTime?        @map("signed_at") @db.Timestamptz
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  owner      User                @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  signatures ContractSignature[]

  @@index([ownerUserId, updatedAt])
  @@map("contracts")
}

/// Evidence of one account signing one contract: when, and from which IP
/// and client. One row per signer; append-only.
model ContractSignature {
  id         String   @id @default(uuid()) @db.Uuid
  contractId String   @map("contract_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  signedAt   DateTime @default(now()) @map("signed_at") @db.Timestamptz

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contractId, userId])
  @@index([userId])
  @@map("contract_signatures")
}

// -----------------------------------------------------------------------------
// 8. Notifications
// -----------------------------------------------------------------------------

/// What happened. The app renders the title and body in the reader's
/// language from the type and `params`.
enum NotificationType {
  consultationRequested
  consultationAccepted
  consultationRejected
  consultationCancelled
  consultationCompleted
  consultationRescheduled
  lawyerVerificationApproved
  lawyerVerificationRejected
}

/// One event for one account. Written only by the server, in the same
/// transaction as the change it reports.
model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  /// Id of the entity it is about (for now always a consultation).
  relatedId String?          @map("related_id") @db.Uuid
  /// Values the text needs, e.g. {"actorName": "...", "scheduledAt": "..."}.
  params    Json             @default("{}")
  readAt    DateTime?        @map("read_at") @db.Timestamptz
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}
