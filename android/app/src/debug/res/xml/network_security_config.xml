<?xml version="1.0" encoding="utf-8"?>
<!-- Debug only: allows plain HTTP so the app can reach a local backend
     (npm run dev) from an emulator or a device on the LAN. Never shipped. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
