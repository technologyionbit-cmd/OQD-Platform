# Copy this file to .env and adjust values for your local environment.
# Never commit a real .env file.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# Comma-separated list of allowed browser origins for CORS.
# In development, leave empty to allow all origins.
# In production this MUST be an explicit list — never a wildcard.
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Database (PostgreSQL via Prisma)
# ---------------------------------------------------------------------------
# Matches the default credentials/port in docker-compose.yml.
DATABASE_URL=postgresql://aqd:aqd_dev_password@localhost:5432/aqd_dev?schema=public

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
# Matches the default port in docker-compose.yml.
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Reserved for future phases — variable names only, NOT implemented yet.
# Do not read/wire these up until the corresponding phase in
# docs/backend/16-backend-roadmap.md is actually started.
# ---------------------------------------------------------------------------

# Auth (Phase 1B — docs/backend/02-auth-and-authorization.md)
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL=30d

# Object storage (Phase 3 — docs/backend/08-contracts-documents-signatures.md)
# STORAGE_ENDPOINT=
# STORAGE_REGION=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=

# AI provider (Phase 7 — docs/backend/11-ai.md)
# AI_PROVIDER_API_KEY=

# Payment provider (Phase 8 — docs/backend/12-billing.md)
# PAYMENT_PROVIDER_SECRET_KEY=
# PAYMENT_PROVIDER_WEBHOOK_SECRET=

# Push notifications (Phase 6 — docs/backend/10-notifications.md)
# PUSH_PROVIDER_KEY=

# WebSocket / real-time (Phase 5 — docs/backend/07-messaging-realtime.md)
# WS_PATH=/v1/ws
