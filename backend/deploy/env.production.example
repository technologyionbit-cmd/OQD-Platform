# Copy to /opt/aqd/backend/.env  (chmod 600, owner aqd)
NODE_ENV=production
PORT=3000
HOST=127.0.0.1
TRUST_PROXY=1
# Your real front-end origins, comma-separated. Never a wildcard.
CORS_ORIGINS=https://app.example.com

DATABASE_URL=postgresql://aqd:CHANGE_DB_PASSWORD@localhost:5432/aqd?schema=public

# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30

# Required in production (OTP SMS)
NGT_SMS_BASE_URL=https://sendsms.ngt.jo/http/send_sms_http.php
NGT_SMS_LOGIN_NAME=
NGT_SMS_LOGIN_PASSWORD=
NGT_SMS_SENDER_ID=

UPLOADS_DIR=/var/lib/aqd/uploads
