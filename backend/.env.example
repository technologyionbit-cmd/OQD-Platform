# Copy this file to .env and adjust values for your local environment.
# Never commit a real .env file.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Interface to bind. Production behind nginx on the same host: 127.0.0.1,
# so the API can only be reached through the proxy.
HOST=0.0.0.0

# Comma-separated list of allowed browser origins for CORS.
# In development, leave empty to allow all origins.
# In production this MUST be an explicit list — never a wildcard.
CORS_ORIGINS=

# Reverse proxy in front of the API (nginx, a load balancer...). Leave empty
# when clients connect directly. Otherwise either the number of proxy hops
# (e.g. 1) or a comma-separated list of proxy addresses/subnets/presets
# (e.g. loopback or 10.0.0.0/8). `true` is rejected: it would let any client
# spoof X-Forwarded-For and bypass per-IP rate limiting.
TRUST_PROXY=

# OpenAPI docs at /v1/docs (JSON at /v1/docs-json). Defaults to on outside
# production and off in production; set explicitly to override.
# API_DOCS_ENABLED=true

# ---------------------------------------------------------------------------
# Database (PostgreSQL via Prisma)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://aqd:aqd_dev_password@localhost:5432/aqd_dev?schema=public

# ---------------------------------------------------------------------------
# Auth (docs/backend/02-auth-and-authorization.md)
# ---------------------------------------------------------------------------
# Access-token signing secret — min 32 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30

BCRYPT_ROUNDS=12
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# SMS OTP via NGT SMSPRO (same gateway/sender as the aalkhat project).
# Empty password = codes only logged to the server log (dev).
NGT_SMS_BASE_URL=https://sendsms.ngt.jo/http/send_sms_http.php
NGT_SMS_LOGIN_NAME=masarsahem
NGT_SMS_LOGIN_PASSWORD=
NGT_SMS_SENDER_ID=al5at

# Per-email sign-in limit (on top of the per-IP limit), identical for
# registered and unknown emails so it can't reveal which accounts exist.
# Resets on its own after the window — no permanent lockout.
LOGIN_MAX_ATTEMPTS=10
LOGIN_ATTEMPT_WINDOW_MINUTES=15

# Emailed one-time codes (email verification, password reset): minimum gap
# between two sends, and the most sends per rolling hour. Counted per
# account for verification (the sign-up code counts) and per address for
# password reset.
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR=5

# Terms/privacy version registration must accept. Bump it when the
# published terms change, together with AppConfig.termsVersion in the app.
# TERMS_VERSION=2026-09-28

# Private uploads (lawyer verification documents). Keep it outside any
# directory the web server serves; production: /var/lib/aqd/uploads.
UPLOADS_DIR=storage/uploads

# ---------------------------------------------------------------------------
# Reserved for future phases — variable names only, NOT implemented yet.
# Do not read/wire these up until the corresponding phase in
# docs/backend/16-backend-roadmap.md is actually started.
# ---------------------------------------------------------------------------

# Object storage (Phase 3 — docs/backend/08-contracts-documents-signatures.md)
# STORAGE_ENDPOINT=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=

# AI provider (Phase 7 — docs/backend/11-ai.md)
# AI_PROVIDER_API_KEY=

# Payment provider (Phase 8 — docs/backend/12-billing.md)
# PAYMENT_PROVIDER_SECRET_KEY=
# PAYMENT_PROVIDER_WEBHOOK_SECRET=

# Redis / WebSocket / push are introduced in later phases (messaging,
# notifications) — see docs/backend/16-backend-roadmap.md.
